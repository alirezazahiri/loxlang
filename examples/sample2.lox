class A {
  init() { this.val = 1; }

  x { print "A.get x"; return this.val; }
  set x(v) { console.log("A.set x", v); this.val = v; }

  foo() { console.log("A.foo",this.val); }
}

class B < A {
  x { print "B.get x"; return super.x + 10; }
  set x(v) { console.log("B.set x", v); super.x = v - 10; }

  foo() { print "B.foo"; super.foo(); }
}

var b = B();
print b.x;
b.x = 50;
print b.x;
b.foo();
